      "request": {"path": "/internal/workout-events", "body": {"provider": "telegram", "provider_subject": "54321", "action": "log", "text": "panca 80x8"}, "idempotency_key": "telegram:update:301"},
      "status": 404,
      "response": {"detail": {"code": "telegram_not_linked", "message": "Connect Telegram from the web app"}},
