    {
      "id": "history-empty",
      "operation": "history",
      "arguments": {"telegram_user_id": 12345, "kind": "workouts", "query": null, "limit": 5},
      "request": {"path": "/internal/history-queries", "body": {"provider": "telegram", "provider_subject": "12345", "kind": "workouts", "limit": 5}, "idempotency_key": null},
      "status": 200,
      "response": {"kind": "workouts", "items": []},
      "expected_kind": "workouts"
